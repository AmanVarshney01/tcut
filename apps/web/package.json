{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:docs": "cp ../../packages/tcut/docs/llms.txt public/llms.txt && cp ../../README.md public/index.md",
    "dev": "bun run sync:docs && vite",
    "build": "bun run sync:docs && bun scripts/sitemap.ts && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && bun scripts/prerender.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "preview": "vite preview",
    "media": "bun scripts/media.ts",
    "test": "bun test tests"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.33",
    "@wterm/core": "^0.5.0",
    "@wterm/react": "^0.5.0",
    "codehike": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/themes": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.36",
    "@tcut/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "termcut": "workspace:*",
    "typescript": "catalog:",
    "vite": "^8.2.2"
  }
}
