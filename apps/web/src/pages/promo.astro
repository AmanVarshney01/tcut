---
import Layout from "../layouts/Layout.astro";
import PromoPlayer from "../promo/PromoPlayer";

const GITHUB = "https://github.com/AmanVarshney01/tcut";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title="tcut — the launch video, as a web page"
  description="The tcut feature tour running live in the browser: the same Remotion composition that rendered the MP4, playing the same tcut recordings."
>
  <div class="mx-auto max-w-[80rem] px-5 py-10 sm:py-14">
    <header class="flex items-center justify-between">
      <a href={import.meta.env.BASE_URL} class="font-mono text-lg font-medium no-underline" aria-label="tcut home">tcut<span class="text-amber">_</span></a>
      <nav class="flex items-center gap-5 font-mono text-sm text-ink-2" aria-label="Primary">
        <a class="no-underline hover:text-ink" href={import.meta.env.BASE_URL}>← Home</a>
        <a class="no-underline hover:text-ink" href={GITHUB}>GitHub</a>
        <a class="no-underline hover:text-ink" href={`${base}/promo.mp4`} download>Download MP4</a>
      </nav>
    </header>

    <main class="mt-10">
      <h1 class="text-[1.4rem] leading-tight sm:text-[1.6rem]">The launch video, running as a web page.</h1>
      <p class="mt-3 max-w-[46rem] text-ink-2">
        Nothing here is a video file of the tour. It is the <a href="https://remotion.dev">Remotion</a> composition that rendered the MP4, playing in your browser
        with <code>@remotion/player</code> — titles are DOM text, the terminal clips are tcut recordings, and you can scrub it. Space plays/pauses; double-click
        for fullscreen.
      </p>

      <div class="mt-8">
        <PromoPlayer client:load />
      </div>

      <p class="mt-4 font-mono text-xs text-ink-3">
        1920×1080 · 75 s · 12 scenes · every terminal clip recorded with <code>tcut</code>, the theme scene is one cast re-rendered nine times. Source of the
        pipeline: the <code>tcut-remotion</code> skill (<code>npx skills add AmanVarshney01/tcut</code>).
      </p>
    </main>
  </div>
</Layout>
