---
import { Code } from "astro:components";
import Layout from "../layouts/Layout.astro";
import CopyCommand from "../components/CopyCommand.astro";
import demoSvg from "../assets/demo.svg?raw";
import facts from "../assets/facts.json";
import btsGif from "../assets/examples/better-t-stack.gif";
import claudeGif from "../assets/examples/claude-code.gif";
import lazygitGif from "../assets/examples/lazygit.gif";
import nvimGif from "../assets/examples/nvim-hmr.gif";
import promoPoster from "../assets/promo-poster.jpg";

const GITHUB = "https://github.com/AmanVarshney01/tcut";
const NPM = "https://www.npmjs.com/package/termcut";
const REFERENCE = `${GITHUB}/blob/main/packages/tcut/docs/REFERENCE.md`;
const EXAMPLES = `${GITHUB}/tree/main/packages/tcut/examples`;

const script = `import { defineVideo } from "tcut";

export default defineVideo({ output: ["demo.mp4", "demo.gif"] }, async (t) => {
  await t.run("bun --version");        // type, Enter, wait for the prompt
  await t.run("ls -la");
  await t.expect(/package\\.json/);     // assert on the screen
  await t.sleep("1.5s");
});`;

const examples = [
  { src: btsGif, alt: "bun create better-t-stack answered with arrow keys", label: "bun create better-t-stack, driven with arrow keys" },
  { src: claudeGif, alt: "Claude Code's interactive TUI editing a file", label: "Claude Code, the interactive TUI, end to end" },
  { src: lazygitGif, alt: "lazygit navigated with the keyboard", label: "lazygit" },
  { src: nvimGif, alt: "Neovim editing App.tsx with a browser window overlaid showing the page update", label: "nvim + a real browser window (overlay), Vite HMR" },
];
---

<Layout>
  <div class="mx-auto max-w-[46rem] px-5 py-10 sm:py-14">
    <header class="flex items-center justify-between">
      <a href={import.meta.env.BASE_URL} class="font-mono text-lg font-medium no-underline" aria-label="tcut home">tcut<span class="text-amber">_</span></a>
      <nav class="flex items-center gap-5 font-mono text-sm text-ink-2" aria-label="Primary">
        <a class="no-underline hover:text-ink" href={GITHUB}>GitHub</a>
        <a class="no-underline hover:text-ink" href={NPM}>npm</a>
        <a class="no-underline hover:text-ink" href={REFERENCE}>Reference</a>
        <button type="button" class="theme-toggle rounded-md border border-line p-1.5 hover:bg-desk-2 hover:text-ink" aria-label="Switch between light and dark theme" title="Theme">
          <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
        </button>
      </nav>
    </header>

    <main class="mt-14 space-y-16">
      <section>
        <h1 class="text-[1.6rem] leading-tight sm:text-[1.85rem]">Turn a terminal session into a video.</h1>
        <p class="mt-3 max-w-[40rem] text-ink-2">
          Record it live or script it in TypeScript. Render to MP4, GIF, WebM, SVG or HTML. Same recording, same pixels, every time.
        </p>
        <div class="mt-6">
          <CopyCommand command="bun add -g termcut" />
        </div>
        <p class="mt-2 text-sm text-ink-3">Bun ≥ 1.4. ffmpeg for MP4/GIF; SVG and HTML need nothing else. Or a <a href={`${GITHUB}/releases`}>standalone binary</a>.</p>
        <figure class="mt-8">
          <video
            class="promo block w-full rounded-lg bg-desk-2"
            src="/promo.mp4"
            poster={promoPoster.src}
            width="1920"
            height="1080"
            controls
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="tcut feature tour: scripted recording, themes, browser overlay, Claude Code, captions, zoom, CI"
          ></video>
          <figcaption class="mt-2 font-mono text-xs text-ink-3">
            75 s tour. Every terminal clip is a tcut recording, composed in <a href="https://remotion.dev">Remotion</a> — a build artifact, not a screen grab.
            The <code>tcut-remotion</code> skill documents the pipeline.
          </figcaption>
        </figure>
      </section>

      <figure>
        <div class="demo-svg overflow-hidden rounded-lg" set:html={demoSvg} />
        <figcaption class="mt-2 font-mono text-xs text-ink-3">
          demo.svg, {Math.round(facts.svgBytes / 1024)} KB, rendered by tcut from a 20-line script. {facts.totalFrames} frames, {facts.uniqueFrames} unique.
        </figcaption>
      </figure>

      <section class="space-y-8">
        <h2 class="text-xl">Record</h2>

        <div>
          <p class="text-ink-2">Live. A clean shell opens; type; exit. You get the recording and a script of what you typed.</p>
          <div class="mt-3"><Code code={`tcut rec -o demo.gif\ntcut rec -o demo.mp4 -- npm create vite   # just one command`} lang="sh" theme="catppuccin-mocha" /></div>
        </div>

        <div>
          <p class="text-ink-2">
            Scripted. Plain TypeScript, so loops, helpers and imports work. <code>run()</code> waits for your prompt to come back, not for a timer; <code>expect()</code> makes the demo a test.
            <code>print()</code> renders Markdown captions into the terminal without typing anything, and <code>browser: {"{ position: \"overlay\" }"}</code> records a real browser window beside or over the terminal, for dev-server demos.
          </p>
          <div class="mt-3"><Code code={script} lang="ts" theme="catppuccin-mocha" /></div>
          <div class="mt-3"><Code code={`tcut demo.video.ts`} lang="sh" theme="catppuccin-mocha" /></div>
        </div>
      </section>

      <section>
        <h2 class="text-xl">Render again</h2>
        <p class="mt-3 text-ink-2">
          Recording and rendering are separate. Every recording is an asciicast; frames are computed on a virtual clock. Change the theme, the size or the format without running anything again. 607 themes, Ghostty's collection.
        </p>
        <div class="mt-3">
          <Code
            code={`tcut render demo.cast --theme "Gruvbox Dark" -o demo.svg -o demo.html\ntcut render demo.cast --width 1280 --height 720 --speed 1.5 -o demo.mp4\ntcut publish demo.gif     # to your own S3-compatible bucket`}
            lang="sh"
            theme="catppuccin-mocha"
          />
        </div>
      </section>

      <section>
        <h2 class="text-xl">Examples</h2>
        <p class="mt-3 text-ink-2">
          tcut waits on the rendered screen, so it can drive anything a person can: menus, prompts, agents that think for ten seconds. All recorded by tcut; scripts in <a href={EXAMPLES}>examples/</a>.
        </p>
        <div class="mt-5 grid gap-6 sm:grid-cols-2">
          {
            examples.map((e) => (
              <figure>
                <img src={e.src.src} width={e.src.width} height={e.src.height} alt={e.alt} loading="lazy" class="block aspect-[16/10] w-full rounded-lg object-cover object-top" />
                <figcaption class="mt-2 font-mono text-xs text-ink-3">{e.label}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="text-xl">Compared with VHS</h2>
        <p class="mt-3 text-ink-2">
          <a href="https://github.com/charmbracelet/vhs">VHS</a> is Go, a <code>.tape</code> DSL, ttyd, Chrome and ffmpeg. tcut is TypeScript, Bun and
          Ghostty's terminal core (libghostty in WASM). What that changes:
        </p>
        <ul class="mt-4 space-y-2 text-ink-2">
          <li>Scripts are TypeScript: loops, imports, shared scenes, autocomplete.</li>
          <li><code>run()</code> waits for your actual prompt instead of a <code>Sleep</code>; <code>wait()</code> matches the rendered screen, not raw bytes.</li>
          <li><code>expect()</code> asserts on the screen, and <code>tcut test</code> runs your demos as tests.</li>
          <li>Record once to a <code>.cast</code>, render forever: new theme, size or format without re-running a shell. VHS screenshots Chrome live, so output depends on machine speed.</li>
          <li><code>tcut rec</code> keeps the exact recording and writes an editable script of what you typed.</li>
          <li>Outputs add animated SVG and a single-file HTML player, neither needs ffmpeg or a browser.</li>
          <li>607 themes from Ghostty's collection; the same colours as your terminal, because the emulator is the same.</li>
          <li>A real browser window beside or over the terminal, for dev-server demos.</li>
          <li>Publish to your own S3-compatible bucket; there is no hosted service.</li>
          <li>Agent-ready: <code>--json</code>, exit codes, no prompts, <a href="/llms.txt">llms.txt</a>.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl">How it works</h2>
        <p class="mt-3 text-ink-2">
          <code>Bun.Terminal</code> runs your shell in a PTY. Output is timestamped into the cast and fed to a headless <a href="https://ghostty.org">Ghostty</a> terminal (via <a href="https://github.com/vercel-labs/wterm">wterm</a>); that is how <code>run()</code> knows the prompt is back and <code>expect()</code> sees what you see.
          Rendering replays the cast into the same terminal inside <code>Bun.WebView</code>, one frame per tick, and hands frames to ffmpeg. SVG and HTML are built straight from the terminal grid.
          Inspired by <a href="https://github.com/charmbracelet/vhs">VHS</a>.
        </p>
        <p class="mt-3 text-ink-2">
          Built for agents as much as people: no prompts, exit codes, <code>--json</code>, an <a href="/llms.txt">llms.txt</a> — and installable skills:
          <code>npx skills add AmanVarshney01/tcut</code> teaches any coding agent tcut, plus a <code>tcut-remotion</code> skill for composing the footage into full launch videos with <a href="https://remotion.dev">Remotion</a>.
        </p>
      </section>
    </main>

    <footer class="mt-20 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5 font-mono text-xs text-ink-3">
      <span>tcut · MIT</span>
      <span class="flex gap-4">
        <a class="no-underline hover:text-ink" href={GITHUB}>GitHub</a>
        <a class="no-underline hover:text-ink" href={NPM}>npm</a>
        <a class="no-underline hover:text-ink" href={REFERENCE}>Reference</a>
        <a class="no-underline hover:text-ink" href="/llms.txt">llms.txt</a>
      </span>
    </footer>
  </div>

  <script>
    // Autoplay the tour only where it is cheap and welcome: wide screens, no reduced-motion preference.
    const promo = document.querySelector<HTMLVideoElement>("video.promo");
    if (promo && matchMedia("(min-width: 640px) and (prefers-reduced-motion: no-preference)").matches) {
      promo.autoplay = true;
      promo.play().catch(() => {});
    }

    const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
    toggle?.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("tcut-theme", next);
    });
  </script>
</Layout>
