---
import { Image } from "astro:assets";
import facts from "../assets/facts.json";

// Every frame here is a real render of docs/demo.cast at 1 fps (see scripts/media.ts).
const modules = import.meta.glob<{ default: ImageMetadata }>("../assets/strip/*.png", { eager: true });
const frames = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);
---

<figure>
  <div class="film">
  <div class="film-track" role="list" aria-label="Rendered frames of the demo, one per second">
    <div class="cut" role="listitem" aria-label={`${facts.hiddenSeconds} seconds of setup cut by t.hide()`}>
      <span class="cut-label">t.hide()</span>
      <span class="cut-time">−{facts.hiddenSeconds}s</span>
    </div>
    {
      frames.map((frame, i) => (
        <div class="frame" role="listitem">
          <Image src={frame} alt={`Frame at ${i} seconds`} width={frame.width / 2} loading={i < 4 ? "eager" : "lazy"} />
          <span class="tc">{String(Math.floor(i / 60)).padStart(2, "0")}:{String(i % 60).padStart(2, "0")}</span>
        </div>
      ))
    }
  </div>
  </div>
  <figcaption class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-ink-2">
    <span><span class="font-mono text-ink">{facts.totalFrames}</span> frames at {facts.fps} fps</span>
    <span><span class="font-mono text-ink">{facts.uniqueFrames}</span> of them are unique — the rest are reused, so idle seconds cost nothing</span>
    <span><span class="font-mono text-ink">{facts.hiddenSeconds}s</span> of setup commands ran but were cut from the timeline</span>
  </figcaption>
</figure>

<style>
  .film {
    --sprocket: 10px;
    background: var(--color-mocha-2);
    padding: 14px 0;
    position: relative;
    overflow: hidden;
  }
  .film::before,
  .film::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: var(--sprocket);
    background-image: radial-gradient(circle at 5px 5px, var(--color-desk) 2.5px, transparent 2.6px);
    background-size: 22px var(--sprocket);
    opacity: 0.55;
  }
  .film::before {
    top: 2px;
  }
  .film::after {
    bottom: 2px;
  }
  .film-track {
    display: flex;
    gap: 6px;
    align-items: stretch;
    overflow-x: auto;
    padding: 0 6px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-ink-3) transparent;
  }
  .frame {
    position: relative;
    flex: 0 0 auto;
    width: clamp(180px, 22vw, 260px);
    border: 1px solid #2a2a3c;
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .tc {
    position: absolute;
    right: 6px;
    bottom: 6px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #cdd6f4;
    background: rgba(17, 17, 27, 0.8);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .cut {
    flex: 0 0 auto;
    width: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-left: 2px dashed var(--color-amber);
    border-right: 2px dashed var(--color-amber);
    color: var(--color-amber);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
  .cut-label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    letter-spacing: 0.04em;
  }
  .cut-time {
    color: #cdd6f4;
  }
</style>
