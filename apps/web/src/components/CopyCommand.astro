---
interface Props {
  command: string;
}
const { command } = Astro.props;
---

<div class="copy-cmd flex items-stretch overflow-hidden rounded-md bg-mocha text-[#cdd6f4]">
  <code class="flex-1 truncate px-4 py-2.5 text-[0.92rem]"><span class="text-[#6c7086]" aria-hidden="true">$ </span>{command}</code>
  <button
    type="button"
    class="copy-btn shrink-0 border-l border-white/10 px-3 font-mono text-xs text-[#a6adc8] hover:bg-white/5 hover:text-white"
    data-command={command}
    aria-label={`Copy “${command}”`}
  >
    copy
  </button>
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".copy-btn")) {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.command ?? "");
        btn.textContent = "copied";
      } catch {
        btn.textContent = "select";
      }
      setTimeout(() => (btn.textContent = "copy"), 1400);
    });
  }
</script>
