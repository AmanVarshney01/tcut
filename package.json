{
  "name": "tcut-monorepo",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.2",
      "@types/node": "^26.5.0",
      "@cloudflare/workers-types": "^5.20260908.1"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev -F web --",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings",
    "demo": "bun run --cwd packages/tcut demo",
    "media": "bun run --cwd apps/web media",
    "deploy": "turbo run deploy -F @tcut/infra --",
    "deploy:prod": "turbo run deploy:prod -F @tcut/infra --",
    "destroy": "turbo run destroy -F @tcut/infra --",
    "sync:readme": "cp README.md packages/tcut/README.md"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@oxlint/plugins": "1.82.0",
    "@tcut/config": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "1.82.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
