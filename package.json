{
  "name": "tcut-monorepo",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "@types/bun": "latest",
      "@types/node": "^22.20.1",
      "@cloudflare/workers-types": "^5.20260728.1"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev -F web --",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "demo": "bun run --cwd packages/tcut demo",
    "media": "bun run --cwd apps/web media",
    "deploy": "turbo run deploy -F @tcut/infra --",
    "deploy:prod": "turbo run deploy:prod -F @tcut/infra --",
    "destroy": "turbo run destroy -F @tcut/infra --",
    "sync:readme": "cp README.md packages/tcut/README.md"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@oxlint/plugins": "1.79.0",
    "@tcut/config": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "1.79.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
