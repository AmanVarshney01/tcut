{
  "name": "tcut-monorepo",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "@types/bun": "latest"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev -F web --",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "demo": "bun run --cwd packages/tcut demo",
    "media": "bun run --cwd apps/web media"
  },
  "devDependencies": {
    "@tcut/config": "workspace:*",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
