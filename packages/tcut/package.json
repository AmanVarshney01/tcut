{
  "name": "termcut",
  "version": "1.4.4",
  "description": "Script terminal sessions in TypeScript, render them to reproducible MP4/GIF/WebM/SVG/HTML with Bun.",
  "license": "MIT",
  "author": "Aman Varshney",
  "homepage": "https://github.com/AmanVarshney01/tcut#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmanVarshney01/tcut.git",
    "directory": "packages/tcut"
  },
  "bugs": {
    "url": "https://github.com/AmanVarshney01/tcut/issues"
  },
  "keywords": [
    "terminal",
    "recording",
    "gif",
    "mp4",
    "svg",
    "asciicast",
    "asciinema",
    "vhs",
    "pty",
    "demo",
    "screencast",
    "bun"
  ],
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./timeline": "./src/timeline.ts",
    "./captions": "./src/captions.ts"
  },
  "bin": {
    "tcut": "bin/tcut.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "src/renderer/generated/presenter.js",
    "src/renderer/generated/presenter.css"
  ],
  "engines": {
    "bun": ">=1.4.1"
  },
  "scripts": {
    "demo": "bun src/cli.ts examples/demo.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "build:assets": "bun scripts/build-assets.ts",
    "build": "bun run build:assets && bun build --compile --bytecode --minify src/cli.ts --outfile dist/tcut",
    "build:all": "bun run build:assets && bun scripts/build-binaries.ts"
  },
  "dependencies": {
    "@wterm/core": "^0.5.0",
    "@wterm/dom": "^0.5.0",
    "@wterm/ghostty": "^0.5.0",
    "@wterm/markdown": "^0.5.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6 || ^7"
  }
}
