{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/packages/tcut/docs/llms.txt"
      ],
      "outputs": [
        "dist/**",
        "dist-ssr/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false,
      "interactive": true
    },
    "deploy:prod": {
      "cache": false,
      "interactive": true
    },
    "destroy": {
      "cache": false,
      "interactive": true
    },
    "termcut#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/presenter/src/**",
        "$TURBO_ROOT$/apps/presenter/vite.config.ts",
        "$TURBO_ROOT$/apps/presenter/package.json"
      ],
      "outputs": [
        "dist/**",
        "src/renderer/generated/**"
      ]
    },
    "@tcut/presenter#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/tcut/src/presentation/model.ts",
        "$TURBO_ROOT$/packages/tcut/src/presentation/capture.ts"
      ]
    }
  }
}
